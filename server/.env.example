PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=automate-email

# Your personal Gmail and a 16-character Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Name shown as sender and used for {{senderName}} in templates
SENDER_NAME=Your Name

# Optional: resume attached to every mail. A local file path, or a public URL
# (Google Drive share links are converted to direct downloads).
RESUME_PATH=
RESUME_FILENAME=Resume.pdf

# Production only: frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=https://your-app.vercel.app
